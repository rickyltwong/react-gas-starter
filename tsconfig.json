{
	"compilerOptions": {
		"target": "ES2019",
		"module": "ESNext",
		"lib": ["ES2019", "DOM"],
		"jsx": "react-jsx",
		"strict": true,
		"noImplicitAny": true,
		"moduleResolution": "Node",
		"outDir": "dist",
		"types": ["jest", "google-apps-script"]
	},
	"include": ["src/**/*", "gas/**/*"],
	"exclude": ["node_modules", "dist"]
}
